{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OCBC TREE v2 assessment result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2"
    },
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "turn_id": {
      "type": "string",
      "minLength": 1
    },
    "input_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "fixture",
        "live",
        "replay"
      ]
    },
    "task_id": {
      "anyOf": [
        {
          "enum": [
            "rate_only",
            "plan_and_rate"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "verdict": {
      "enum": [
        "ready",
        "hold"
      ]
    },
    "reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "clarify_intent",
          "unsupported_task",
          "branch_blocked",
          "extra_claim",
          "unmapped_text"
        ]
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "covered": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "required": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "covered",
        "required"
      ]
    },
    "branches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "decision_id": {
            "enum": [
              "deposit_rate",
              "single_transfer"
            ]
          },
          "status": {
            "enum": [
              "covered",
              "omitted",
              "wrong",
              "need_fact",
              "policy_review",
              "uncertain_text"
            ]
          },
          "expected": {
            "anyOf": [
              {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "rate_bps": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "rate_bps"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "limit_cents": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "within_cap": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "limit_cents",
                      "within_cap"
                    ]
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "spans": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "end": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "start",
                "end",
                "quote"
              ]
            }
          },
          "source_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "fact_keys": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "product",
                "currency",
                "booking_region",
                "segment",
                "channel",
                "tenor_months",
                "deposit_cents",
                "transfer_cents"
              ]
            }
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "decision_id",
          "status",
          "expected",
          "spans",
          "source_ids",
          "fact_keys",
          "explanation"
        ]
      }
    },
    "extras": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "span": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "end": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "start",
              "end",
              "quote"
            ]
          },
          "status": {
            "enum": [
              "supported",
              "wrong",
              "unresolved"
            ]
          },
          "source_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "span",
          "status",
          "source_ids",
          "explanation"
        ]
      }
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "passage_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "governing",
              "context",
              "excluded",
              "pending"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "passage_id",
          "version",
          "text",
          "state",
          "reason"
        ]
      }
    },
    "next": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "use",
            "clarify_intent",
            "supply_fact",
            "review_policy",
            "review_text",
            "review_repair"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "product",
              "currency",
              "booking_region",
              "segment",
              "channel",
              "tenor_months",
              "deposit_cents",
              "transfer_cents"
            ]
          }
        }
      },
      "required": [
        "kind",
        "prompt",
        "fields"
      ]
    },
    "repair": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "source_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "text",
            "source_ids"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "assessment_id",
    "turn_id",
    "input_revision",
    "bundle_id",
    "snapshot_id",
    "mode",
    "task_id",
    "verdict",
    "reasons",
    "coverage",
    "branches",
    "extras",
    "roots",
    "next",
    "repair"
  ]
}
